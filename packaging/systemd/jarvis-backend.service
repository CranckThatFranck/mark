[Unit]
Description=Mark Alfa Backend Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/jarvis/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/jarvis/venv/bin/python /opt/jarvis/backend/server.py
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
